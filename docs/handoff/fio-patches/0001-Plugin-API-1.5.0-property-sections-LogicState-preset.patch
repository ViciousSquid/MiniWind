+"""
+
+from plugins.api import FioPlugin
+
+
+class NextMinorPlugin(FioPlugin):
+    name = "next_minor_api"
+    version = "1.0.0"
+    api_version = "1.6.0"
+    description = "Needs a newer minor plugin API than this host has."
