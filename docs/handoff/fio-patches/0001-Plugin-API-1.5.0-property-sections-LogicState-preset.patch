+# Entity Inspector: panel
+# ---------------------------------------------------------------------------
+
+def test_the_panel_draws_rows_and_bars(api, qt_app):
+    thing = Thing(pos=[0, 0, 0], properties={"type": "gauge", "level": 4})
+    api.register_entity_inspector(lambda e, logic: {
