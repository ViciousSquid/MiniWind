{
  "id": "mill_bandits",
  "name": "Trouble at the Old Mill",
  "giver": "Elowen",
  "faction": "town",
  "starts_on_new_game": true,
  "chapter": 1,
  "chapter_title": "The Old Mill",
  "desc": "Millbrook has no flour, and Elowen wants to know why.",
  "xp": 40,
  "rewards": {
    "gold": 150,
    "items": [
      [
        "steel_longsword",
        1
      ]
    ],
    "rep": [
      "town",
      15
    ]
  },
  "stages": [
    {
      "index": 0,
      "journal": "Elowen the Trader called me over in Millbrook square. Something about flour.",
      "objective": "Talk to Elowen",
      "finishes": false,
      "condition": {
        "kind": "talk",
        "target": "Elowen",
        "count": 1
      },
      "say": "Eight sacks a week, I sell. Today I've {shelf_flour} on the shelf, and it isn't for want of asking. Ever since bandits took the Old Mill, the Cross sends its runner to Mara's windmill, and Millbrook gets whatever's left. Ask Mara. She'll tell you.",
      "call": "You! New face! Have you got a minute?"
    },
    {
      "index": 10,
      "journal": "Elowen has no flour to sell. Since bandits took the Old Mill, Hollin's Cross buys from Mara's windmill and Millbrook goes short. She told me to ask Mara.",
      "objective": "Ask Mara about the flour",
      "finishes": false,
      "condition": {
        "kind": "talk",
        "target": "Mara",
        "count": 1
      },
      "say": "Sails don't turn on wind alone. They turn on wheat, and nobody's bringing me enough. There's {mill_wheat} wheat in the hopper and {mill_flour} flour in the loft, and the Cross's man is first in line for it. The Old Mill, north-east of here, used to grind for the Cross. Bandits sit in it now. Get them out, and the carts go back where they belong."
    },
    {
      "index": 20,
      "journal": "Mara's windmill can't grind for two villages. The Old Mill north-east of Millbrook used to take the Cross's grain, until bandits moved in.",
      "objective": "Find the Old Mill",
      "finishes": false,
      "condition": {
        "kind": "visit",
        "target": "Old Mill",
        "count": 1
      }
    },
    {
      "index": 30,
      "journal": "I found the Old Mill. Bandits everywhere.",
      "objective": "Kill 4 bandits at the mill",
      "finishes": false,
      "condition": {
        "kind": "kill",
        "target": "bandits",
        "count": 4
      },
      "waypoint": "bandits"
    },
    {
      "index": 40,
      "journal": "The bandits at the Old Mill are dead. Aldric the Reeve keeps the tolls at Hollin's Cross. He should hear the mill is clear.",
      "objective": "Tell Aldric at Hollin's Cross",
      "finishes": false,
      "condition": {
        "kind": "talk",
        "target": "Aldric",
        "count": 1
      },
      "say": "The Old Mill? Clear? Then the carts can roll again, and the Cross can buy its own flour instead of taking Millbrook's. The Cross thanks you, and so does my purse, reluctantly. One more thing: there's talk the flour went south, to the shore. South shore means Mirrormere, and Old Maud at Reedhollow sees every boat on that water."
    },
    {
      "index": 50,
      "journal": "Aldric paid me for clearing the Old Mill. Hollin's Cross will grind its own grain again, and Millbrook's shelves should fill. He says the stolen flour went south, to Mirrormere; Old Maud at Reedhollow sees every boat on that water.",
      "objective": "Aldric paid me for clearing the Old Mill.",
      "finishes": true
    }
  ]
}
