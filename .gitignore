__pycache__/
*.py[cod]
.pytest_cache/

# Regenerated from engine/shaders.py:DEFAULT_SHADERS every time a renderer is
# constructed (see ShaderLoader._ensure_defaults), so it is build output rather
# than source. The visual test tier creates it too.
assets/shaders/


# Generated head death-overlay composites (never real art)
assets/sprites/heads/dead_cache/

# Audit working files (regenerate with git rev-list)
audit/_commits*.txt

# Play-session saves written by the console and the pause menu
saves/

# Map pictures painted once per map (game/ui/worldmap.py)
cache/

# Generated before freezing; source checkouts compute the live hash.
game/data/multiplayer_build.json

# Runtime logs: errors, crashes and freeze reports (engine/error_report.py)
logs/
# Fio's crash logs, next to settings.ini (editor/crash_log.py)
fio_crash.log
fio_crash.log.1
fio_fault.log
fio_fault.log.1
# Temporary level pair the level-changer e2e test writes (and removes) while
# it runs (tests/e2e/test_level_changer_spawns.py).
maps/_e2e_*.json
maps/*_autosave.json

# Console dumps written by the debug console's `condump` command.
logs/
.claude/worktrees/
